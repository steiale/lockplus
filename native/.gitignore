# LockPlus native: build outputs and fetched vendor sources (never /tmp, DESIGN §2.1)
/build/
/Vendor/build/
/Vendor/src/
/Vendor/dl/
/Vendor/gomodcache/
/Config/DevStamp.xcconfig
.swiftpm/
.build/
xcuserdata/
# Per-machine settings sourced by Tools/lib/paths.sh (LP_NOTARY_PROFILE, …)
/Tools/lib/local.zsh
*.xcuserstate
/Vendor/openvpn3/
/Vendor/openssl/
/Vendor/asio/
/Vendor/lz4/
/Vendor/wireguard-apple/
# Apple tooling: on the first run of a new Xcode, xcodebuild may write its spec cache relative to the cwd
# (native/27.2-27B52/Xcode/CachedSpecifications-xcodebuild, 2026-10-30) instead of $DARWIN_USER_CACHE_DIR. Our
# scripts run version probes from $LP_BUILD_ROOT; this catches the rest.
/[0-9]*.[0-9]*-[0-9A-Z]*/
