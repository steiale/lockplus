+// LockPlus W12: the socketpair end is wrapped in a non-blocking *os.File, so it lives in Go's netpoller and Close wakes
+// a Read that is blocked in another goroutine. (A raw blocking read(2) is not woken by shutdown(2) on a socketpair
+// end, and wgTurnOff, which waits for the read routine, would hang.)
 type pfTun struct {
-	fd        int
+	file      *os.File
+	rc        syscall.RawConn
 	mtu       int
 	events    chan tun.Event
 	closeOnce sync.Once
 }
 
+// newPFTun owns fd on every path (NEW-4): on success the returned pfTun closes it; on failure it is already closed,
+// exactly once (unix.Close before os.NewFile, the *os.File after it), and the caller must not close it again.
+func newPFTun(fd int, mtu int) (*pfTun, error) {
+	if fd < 0 {
+		return nil, errors.New("invalid fd")
+	}
+	if err := unix.SetNonblock(fd, true); err != nil {
+		unix.Close(fd)
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), "lockplus-pf")
+	if f == nil {
+		unix.Close(fd)
+		return nil, errors.New("os.NewFile failed")
+	}
+	rc, err := f.SyscallConn()
+	if err != nil {
+		f.Close()
+		return nil, err
+	}
+	t := &pfTun{file: f, rc: rc, mtu: mtu, events: make(chan tun.Event, 10)}
+	t.events <- tun.EventUp
+	return t, nil
+}
+
 func (t *pfTun) File() *os.File { return nil }
 
 func (t *pfTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
 	buf := bufs[0][offset-4:]
 	for {
-		n, err := unix.Read(t.fd, buf)
-		if err == unix.EINTR {
-			continue
+		n, err := t.file.Read(buf)
+		if err == io.EOF {
+			return 0, os.ErrClosed
 		}
 		if err != nil {
-			return 0, err
+			return 0, err // os.ErrClosed once Close has run
 		}
 		if n == 0 {
 			return 0, os.ErrClosed
@@ -67,16 +98,20 @@ func (t *pfTun) Write(bufs [][]byte, offset int) (int, error) {
 			return i, unix.EAFNOSUPPORT
 		}
 		for {
-			_, err := unix.Write(t.fd, buf)
-			if err == unix.EINTR {
+			var werr error
+			// Control (not Write): a full socket must drop the packet, not park this goroutine in the poller.
+			if cerr := t.rc.Control(func(fd uintptr) { _, werr = unix.Write(int(fd), buf) }); cerr != nil {
+				return i, cerr
+			}
+			if werr == unix.EINTR {
 				continue
 			}
-			if err == unix.ENOBUFS || err == unix.EAGAIN {
+			if werr == unix.ENOBUFS || werr == unix.EAGAIN {
 				// The far end is momentarily full: drop, like a utun under pressure.
 				break
 			}
-			if err != nil {
-				return i, err
+			if werr != nil {
+				return i, werr
 			}
 			break
 		}
@@ -90,26 +125,35 @@ func (t *pfTun) Events() <-chan tun.Event { return t.events }
 func (t *pfTun) BatchSize() int           { return 1 }
 func (t *pfTun) Close() error {
 	t.closeOnce.Do(func() {
-		unix.Shutdown(t.fd, unix.SHUT_RDWR) // wakes a blocked Read
-		unix.Close(t.fd)
+		t.file.Close() // closes the fd and wakes a blocked Read with os.ErrClosed
 		close(t.events)
 	})
 	return nil
 }
 
