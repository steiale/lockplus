+// SPDX-License-Identifier: MIT
+//
+// LockPlus W12 tests (run by Tools/bootstrap/vendor.sh): pfTun.Close must wake a blocked reader promptly (T5), and
+// handle numbers must not be reused while a stale holder may still exist (T13).
+
+package main
+
+import (
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestPFTunCloseWakesBlockedRead(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[1])
+	p, err := newPFTun(fds[0], 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	readErr := make(chan error, 1)
+	go func() {
+		bufs := [][]byte{make([]byte, 2048)}
+		_, err := p.Read(bufs, make([]int, 1), 16)
+		readErr <- err
+	}()
+	time.Sleep(100 * time.Millisecond) // let the reader block in the poller
+	start := time.Now()
+	p.Close()
+	select {
+	case err := <-readErr:
+		if !errors.Is(err, os.ErrClosed) {
+			t.Fatalf("Read returned %v, want os.ErrClosed", err)
+		}
+		if d := time.Since(start); d > time.Second {
+			t.Fatalf("Close took %v to wake the reader", d)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("Read still blocked 3s after Close")
+	}
+	p.Close() // idempotent
+}
+
+func TestPFTunDropsWhenFull(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[1])
+	p, err := newPFTun(fds[0], 1420)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	pkt := make([]byte, 4+20)
+	pkt[4] = 0x45
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for i := 0; i < 20000; i++ { // nobody reads fds[1]: the buffer fills, Write must drop rather than block
+			if _, err := p.Write([][]byte{pkt}, 4); err != nil {
+				t.Errorf("Write: %v", err)
+				return
+			}
+		}
+	}()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("Write blocked on a full socket")
+	}
+}
+
+func TestHandlesAreNotReused(t *testing.T) {
+	a := storeHandle(nil, nil)
+	b := storeHandle(nil, nil)
+	if a <= 0 || b <= a {
+		t.Fatalf("handles %d, %d: want positive and increasing", a, b)
+	}
+	removeHandle(a)
+	c := storeHandle(nil, nil)
+	if c == a || c <= b {
+		t.Fatalf("handle %d reused or not monotonic after removing %d (last %d)", c, a, b)
+	}
+	removeHandle(b)
+	removeHandle(c)
+}
+
+// NEW-4: wgTurnOnPF owns pfFd on every error path: a failing start leaves it closed (by exactly one owner, newPFTun
+// or the pfTun via dev.Close; the caller must not close it again).
+func TestTurnOnPFClosesFDOnceOnError(t *testing.T) {
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_DGRAM, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer unix.Close(fds[1])
+	if h := turnOnPF("not_a_key=1\n", int32(fds[0]), 1420); h != -1 {
+		removeHandle(h)
+		t.Fatalf("turnOnPF with bad settings returned handle %d", h)
+	}
+	if _, err := unix.FcntlInt(uintptr(fds[0]), unix.F_GETFD, 0); err != unix.EBADF {
+		t.Fatalf("pfFd still open after a failed turnOnPF (fcntl err %v)", err)
+	}
+	// An invalid fd is refused without touching anything.
+	if h := turnOnPF("", -1, 1420); h != -1 {
+		t.Fatalf("turnOnPF(-1) returned %d", h)
+	}
+}
