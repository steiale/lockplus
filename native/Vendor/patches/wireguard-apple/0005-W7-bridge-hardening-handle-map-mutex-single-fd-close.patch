@@ -102,8 +130,9 @@ func wgTurnOn(settings *C.char, tunFd int32) int32 {
 	}
 	tun, err := tun.CreateTUNFromFile(os.NewFile(uintptr(dupTunFd), "/dev/tun"), 0)
 	if err != nil {
