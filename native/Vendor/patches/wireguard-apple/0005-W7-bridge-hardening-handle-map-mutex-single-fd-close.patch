+		// hit a descriptor number another thread has reused meanwhile (an openvpn3 socket in this process).
 		logger.Errorf("Unable to create new tun device from fd: %v", err)
-		unix.Close(dupTunFd)
 		return -1
 	}
 	logger.Verbosef("Attaching to interface")
@@ -111,41 +140,35 @@ func wgTurnOn(settings *C.char, tunFd int32) int32 {
 
 	err = dev.IpcSet(C.GoString(settings))
