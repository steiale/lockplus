@@ -30,8 +30,14 @@ import (
 	"golang.zx2c4.com/wireguard/tun"
 )
 
-var loggerFunc unsafe.Pointer
-var loggerCtx unsafe.Pointer
+// LockPlus W7: the logger is one process-global (func, ctx) pair, swapped atomically, so a log line on any Go
+// thread never sees a torn pair.
+type cLoggerTarget struct {
+	fn  unsafe.Pointer
+	ctx unsafe.Pointer
+}
+
+var loggerTarget atomic.Pointer[cLoggerTarget]
 
 type CLogger int
 
@@ -45,41 +51,63 @@ func cstring(s string) *C.char {
 }
 
 func (l CLogger) Printf(format string, args ...interface{}) {
-	if uintptr(loggerFunc) == 0 {
+	t := loggerTarget.Load()
+	if t == nil || uintptr(t.fn) == 0 {
 		return
 	}
-	C.callLogger(loggerFunc, loggerCtx, C.int(l), cstring(fmt.Sprintf(format, args...)))
+	C.callLogger(t.fn, t.ctx, C.int(l), cstring(fmt.Sprintf(format, args...)))
 }
 
 type tunnelHandle struct {
 	*device.Device
 	*device.Logger
+	lastHandshakeSend atomic.Int64 // W4: wall-clock ns of the last forced initiation (RekeyTimeout rate limit)
 }
 
-var tunnelHandles = make(map[int32]tunnelHandle)
+// LockPlus W7: the handle map is shared by every export; Swift serializes its calls per adapter, but two adapters
+// (and wgTurnOff from a deinit) may run concurrently, so the map is guarded.
+var (
+	tunnelHandlesMu sync.Mutex
+	tunnelHandles   = make(map[int32]*tunnelHandle)
+)
 
-func init() {
-	signals := make(chan os.Signal)
-	signal.Notify(signals, unix.SIGUSR2)
-	go func() {
-		buf := make([]byte, os.Getpagesize())
-		for {
-			select {
-			case <-signals:
-				n := runtime.Stack(buf, true)
-				buf[n] = 0
-				if uintptr(loggerFunc) != 0 {
-					C.callLogger(loggerFunc, loggerCtx, 0, (*C.char)(unsafe.Pointer(&buf[0])))
-				}
-			}
+func lookupHandle(h int32) (*tunnelHandle, bool) {
+	tunnelHandlesMu.Lock()
+	defer tunnelHandlesMu.Unlock()
+	th, ok := tunnelHandles[h]
+	return th, ok
+}
+
+// storeHandle returns the new handle, or -1 when the map is full (the caller closes the device).
+func storeHandle(dev *device.Device, logger *device.Logger) int32 {
+	tunnelHandlesMu.Lock()
+	defer tunnelHandlesMu.Unlock()
+	var i int32
+	for i = 0; i < math.MaxInt32; i++ {
+		if _, exists := tunnelHandles[i]; !exists {
+			tunnelHandles[i] = &tunnelHandle{Device: dev, Logger: logger}
+			return i
 		}
-	}()
+	}
+	return -1
 }
 
+func removeHandle(h int32) (*tunnelHandle, bool) {
+	tunnelHandlesMu.Lock()
+	defer tunnelHandlesMu.Unlock()
+	th, ok := tunnelHandles[h]
+	if ok {
+		delete(tunnelHandles, h)
+	}
+	return th, ok
+}
+
+// LockPlus W7: upstream's SIGUSR2 goroutine dumper is removed. Its page-sized buffer was indexed one past the end
+// when the dump filled it (runtime.Stack returns n == len(buf)), so `kill -USR2` could crash the root extension.
+
 //export wgSetLogger
 func wgSetLogger(context, loggerFn uintptr) {
-	loggerCtx = unsafe.Pointer(context)
-	loggerFunc = unsafe.Pointer(loggerFn)
+	loggerTarget.Store(&cLoggerTarget{fn: unsafe.Pointer(loggerFn), ctx: unsafe.Pointer(context)})
 }
 
