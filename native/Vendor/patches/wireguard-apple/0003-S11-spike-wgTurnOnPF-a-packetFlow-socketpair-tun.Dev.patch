+/* SPDX-License-Identifier: MIT
+ *
+ * LockPlus spike S11 (DESIGN §7.3 `dataPlane = .packetFlow`): a tun.Device over one end of a
+ * socketpair(AF_UNIX, SOCK_DGRAM). The provider pumps NEPacketTunnelFlow <-> the other end.
+ * Framing is the utun framing (4-byte AF header), so the Swift pump is shared with openvpn3.
+ */
+
+package main
+
+// #include <sys/types.h>
+import "C"
+
+import (
+	"errors"
+	"math"
+	"os"
+	"sync"
+
+	"golang.org/x/sys/unix"
+	"golang.zx2c4.com/wireguard/conn"
+	"golang.zx2c4.com/wireguard/device"
+	"golang.zx2c4.com/wireguard/tun"
+)
+
+type pfTun struct {
+	fd        int
+	mtu       int
+	events    chan tun.Event
+	closeOnce sync.Once
+}
+
+func (t *pfTun) File() *os.File { return nil }
+
+func (t *pfTun) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	buf := bufs[0][offset-4:]
+	for {
+		n, err := unix.Read(t.fd, buf)
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil {
+			return 0, err
+		}
+		if n == 0 {
+			return 0, os.ErrClosed
+		}
+		if n < 4 {
+			continue
+		}
+		sizes[0] = n - 4
+		return 1, nil
+	}
+}
+
+func (t *pfTun) Write(bufs [][]byte, offset int) (int, error) {
+	if offset < 4 {
+		return 0, errors.New("short offset")
+	}
+	for i, buf := range bufs {
+		buf = buf[offset-4:]
+		buf[0], buf[1], buf[2] = 0, 0, 0
+		switch buf[4] >> 4 {
+		case 4:
+			buf[3] = unix.AF_INET
+		case 6:
+			buf[3] = unix.AF_INET6
+		default:
+			return i, unix.EAFNOSUPPORT
+		}
+		for {
+			_, err := unix.Write(t.fd, buf)
+			if err == unix.EINTR {
+				continue
+			}
+			if err == unix.ENOBUFS || err == unix.EAGAIN {
+				// The far end is momentarily full: drop, like a utun under pressure.
+				break
+			}
+			if err != nil {
+				return i, err
+			}
+			break
+		}
+	}
+	return len(bufs), nil
+}
+
+func (t *pfTun) MTU() (int, error)        { return t.mtu, nil }
+func (t *pfTun) Name() (string, error)    { return "pf", nil }
+func (t *pfTun) Events() <-chan tun.Event { return t.events }
+func (t *pfTun) BatchSize() int           { return 1 }
+func (t *pfTun) Close() error {
+	t.closeOnce.Do(func() {
+		unix.Shutdown(t.fd, unix.SHUT_RDWR) // wakes a blocked Read
+		unix.Close(t.fd)
+		close(t.events)
+	})
+	return nil
+}
+
+// wgTurnOnPF takes ownership of pfFd (one end of a socketpair). Returns a handle or -1.
+//
+//export wgTurnOnPF
+func wgTurnOnPF(settings *C.char, pfFd int32, mtu int32) int32 {
+	logger := &device.Logger{
+		Verbosef: CLogger(0).Printf,
+		Errorf:   CLogger(1).Printf,
+	}
+	t := &pfTun{fd: int(pfFd), mtu: int(mtu), events: make(chan tun.Event, 10)}
+	t.events <- tun.EventUp
+	logger.Verbosef("Attaching to packetFlow socketpair fd %d", pfFd)
+	dev := device.NewDevice(t, conn.NewStdNetBind(), logger)
+	if err := dev.IpcSet(C.GoString(settings)); err != nil {
+		logger.Errorf("Unable to set IPC settings: %v", err)
+		dev.Close()
+		return -1
+	}
+	dev.Up()
+	var i int32
+	for i = 0; i < math.MaxInt32; i++ {
+		if _, exists := tunnelHandles[i]; !exists {
+			break
+		}
+	}
+	if i == math.MaxInt32 {
+		dev.Close()
+		return -1
+	}
+	tunnelHandles[i] = tunnelHandle{dev, logger}
+	return i
+}
