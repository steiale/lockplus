          }
        }
      }
    },
    "The old LockPlus helper is still installed. LockPlus can remove it; macOS asks for an administrator password." : {
      "comment" : "§4.5 banner (E2E-5 F1)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hilfsprogramm des alten LockPlus ist noch installiert. LockPlus kann es entfernen; macOS fragt dafür nach einem Administratorpasswort."
          }
