    "^[%lld directive](inflect: true) not needed" : {
      "comment" : "Import report summary; harmless directives LockPlus doesn't need",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
