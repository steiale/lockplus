      }
    },
    "The tunnel component is damaged" : {
      "comment" : "Row 1",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tunnelkomponente ist beschädigt"
          }
        }
      }
    },
    "The tunnel component is damaged." : {
