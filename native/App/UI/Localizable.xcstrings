    },
    "A second configuration of %@ was started outside LockPlus and is waiting. Stop it in System Settings › VPN." : {
      "comment" : "Diagnostics note (2.0.1 round 5): a duplicate VPN configuration of an active profile, started elsewhere, waits in the extension and keeps LockPlus from changing configurations",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zweite Konfiguration von %@ wurde außerhalb von LockPlus gestartet und wartet. Stoppe sie in den Systemeinstellungen › VPN."
          }
        }
      }
    },
    "a server option; not needed by a client" : {
      "comment" : "Import reason, ignored directive",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server-Option; ein Client braucht sie nicht"
          }
        }
      }
    },
    "A VPN configuration LockPlus can't address is active. LockPlus makes no VPN configuration changes, auto-connect included, until it ends." : {
      "comment" : "Auto-connect status and Diagnostics note: a configuration without a usable profile ID is active (E2E-4 review L1)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine VPN-Konfiguration, die LockPlus nicht ansprechen kann, ist aktiv. LockPlus ändert keine VPN-Konfigurationen, auch nicht für Automatisches Verbinden, bis sie endet."
          }
        }
      }
    },
    "A newer tunnel component (%@) is installed. Reinstall to use this version." : {
      "comment" : "Extension failure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neuere Tunnelkomponente (%@) ist installiert. Installiere diese Version erneut, um sie zu verwenden."
          }
        }
      }
    },
    "A newer tunnel component is installed." : {
