          }
        }
      }
    },
    "The installed helper doesn't match the old LockPlus helper, so LockPlus didn't change anything." : {
      "comment" : "§4.5 removal refused: unexpected files (E2E-5 F1)",
      "localizations" : {
        "de" : {
