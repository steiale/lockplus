      }
    },
    "LockPlus adds the VPN configuration for %@ when another user's VPN connection ends." : {
      "comment" : "Onboarding step 3: the first save waits for another user's VPN connection (E2E-4 L1)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus fügt die VPN-Konfiguration für %@ hinzu, sobald die VPN-Verbindung eines anderen Benutzers endet."
          }
        }
      }
    },
    "LockPlus adds the VPN configuration for %@ when the active VPN configuration LockPlus can't address disconnects." : {
      "comment" : "Onboarding step 3: the first save waits for a configuration LockPlus can't address (E2E-4 L1)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus fügt die VPN-Konfiguration für %@ hinzu, sobald die aktive VPN-Konfiguration, die LockPlus nicht ansprechen kann, getrennt wird."
          }
        }
      }
    },
    "LockPlus adds the VPN configuration for %@ when the current VPN connection ends." : {
      "comment" : "Onboarding step 3: the first save waits for a VPN connection LockPlus doesn't own (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus fügt die VPN-Konfiguration für %@ hinzu, sobald die aktuelle VPN-Verbindung endet."
          }
        }
      }
    },
    "LockPlus can connect after the restart." : {
      "comment" : "Row 1, reboot",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Neustart kann LockPlus eine Verbindung herstellen."
          }
        }
      }
    },
    "LockPlus can't connect without this." : {
      "comment" : "Onboarding step 3, denied",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne dies kann LockPlus keine Verbindung herstellen."
          }
        }
      }
    },
    "LockPlus couldn't read its settings (%@) and started with default settings." : {
      "comment" : "Problem: settings.json was unreadable and couldn't be moved aside (E2E-4)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus konnte seine Einstellungen nicht lesen (%@) und wurde mit den Standardeinstellungen gestartet."
          }
        }
      }
    },
    "LockPlus couldn't read its settings (%@) and started with default settings. The old file was kept as %@." : {
      "comment" : "Problem: settings.json was unreadable and moved aside (E2E-4)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus konnte seine Einstellungen nicht lesen (%1$@) und wurde mit den Standardeinstellungen gestartet. Die alte Datei wurde als %2$@ aufbewahrt."
          }
        }
      }
    },
    "LockPlus couldn't remove everything" : {
      "comment" : "§4.4 residual sheet title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus konnte nicht alles entfernen"
          }
        }
      }
    },
    "LockPlus couldn't update its tunnel component, so %@ can't connect yet. Profiles set up before the update still connect." : {
      "comment" : "Problem: a profile was imported while the tunnel component update had failed (E2E-4 review L5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus konnte seine Tunnelkomponente nicht aktualisieren, daher kann sich %@ noch nicht verbinden. Profile, die vor dem Update eingerichtet wurden, verbinden sich weiterhin."
          }
        }
      }
    },
    "LockPlus couldn't update its tunnel component. Profiles set up before the update still connect, but LockPlus can't show their details until the update completes." : {
      "comment" : "Extension update failed while the old one keeps working (E2E-4, U15)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus konnte seine Tunnelkomponente nicht aktualisieren. Profile, die vor dem Update eingerichtet wurden, verbinden sich weiterhin, aber LockPlus kann ihre Details erst nach Abschluss des Updates anzeigen."
          }
        }
      }
    },
    "LockPlus hasn't checked this profile with its OpenVPN engine yet. It's checked as soon as the tunnel component is running; until then it can't connect." : {
      "comment" : "Not yet verified explanation (§8.1)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus hat dieses Profil noch nicht mit seiner OpenVPN-Engine geprüft. Die Prüfung erfolgt, sobald die Tunnelkomponente läuft; bis dahin ist keine Verbindung möglich."
          }
        }
      }
    },
    "LockPlus is already running" : {
      "comment" : "Second instance alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus wird bereits ausgeführt"
          }
        }
      }
    },
    "LockPlus is checking why %@ stopped." : {
      "comment" : "Help on a disabled Connect while the cause of a disconnect is read (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus prüft, warum %@ beendet wurde."
          }
        }
      }
    },
    "LockPlus is finishing a tunnel component update. Try again in a moment." : {
      "comment" : "Sparkle refused an update session (§12.3 step 8)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus schließt gerade ein Update der Tunnelkomponente ab. Versuche es gleich noch einmal."
          }
        }
      }
    },
    "LockPlus is preparing to connect %@." : {
      "comment" : "Help on a disabled Connect while a start is prepared (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus bereitet die Verbindung mit %@ vor."
          }
        }
      }
    },
    "LockPlus is still starting. Try again in a moment." : {
      "comment" : "Sparkle refused an update session: settings not read yet (E2E-4 review L3)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus startet noch. Versuche es gleich noch einmal."
          }
        }
      }
    },
    "LockPlus is waiting for %@ to disconnect, then connects %@." : {
      "comment" : "Help on a disabled Connect while a start waits for a stop (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus wartet, bis %1$@ getrennt ist, und verbindet dann %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "LockPlus is waiting for %1$@ to disconnect, then connects %2$@."
          }
        }
      }
    },
    "LockPlus is waiting for %@'s tunnel process to restart." : {
      "comment" : "Help on a disabled Connect while a crash restart is awaited (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus wartet auf den Neustart des Tunnelprozesses von %@."
          }
        }
      }
    },
    "LockPlus keeps running. Open it from the Dock or the Applications folder, and turn the icon back on here." : {
      "comment" : "Hide icon confirmation message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus läuft weiter. Öffne es über das Dock oder den Ordner „Programme“ und aktiviere das Symbol hier wieder."
          }
        }
      }
    },
    "LockPlus lives here" : {
      "comment" : "Onboarding callout under the menu bar icon",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ist LockPlus zu Hause"
          }
        }
      }
    },
    "LockPlus lives in your menu bar" : {
      "comment" : "Onboarding step 5",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus wohnt in deiner Menüleiste"
          }
        }
      }
    },
    "LockPlus removes its tunnel component and its VPN configurations. Your profiles and the passwords you saved stay on this Mac unless you choose otherwise below." : {
      "comment" : "Uninstall explanation (DESIGN §4.4)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus entfernt seine Tunnelkomponente und seine VPN-Konfigurationen. Deine Profile und die Passwörter, die du gesichert hast, bleiben auf diesem Mac, sofern du unten nichts anderes wählst."
          }
        }
      }
    },
    "LockPlus runs its VPN engine as a macOS system extension. macOS will ask you to allow it once." : {
      "comment" : "Onboarding step 2",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus betreibt seine VPN-Engine als macOS-Systemerweiterung. macOS fragt einmalig, ob du sie erlaubst."
          }
        }
      }
    },
    "LockPlus tells you when protection stops unexpectedly." : {
      "comment" : "Notification permission explanation (§6.13)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus informiert dich, wenn der Schutz unerwartet endet."
          }
        }
      }
    },
    "LockPlus will disconnect and allow unprotected internet for %@." : {
      "comment" : "Pause confirmation; the argument is like '15 minutes'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LockPlus trennt die Verbindung und erlaubt für %@ ungeschütztes Internet."
          }
        }
      }
    },
    "LockPlus's OpenVPN engine rejected the profile." : {
      "comment" : "Editor engine check",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OpenVPN-Engine von LockPlus hat das Profil abgelehnt."
          }
        }
      }
    },
    "LockPlus's background item isn't allowed yet, so if you quit LockPlus, protection resumes the next time it opens instead of on time. Allow LockPlus in System Settings › General › Login Items." : {
      "comment" : "Pause sheet note when the resume agent needs approval (§10.4)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hintergrundobjekt von LockPlus ist noch nicht erlaubt. Wenn du LockPlus beendest, wird der Schutz daher erst beim nächsten Öffnen statt pünktlich fortgesetzt. Erlaube LockPlus in den Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen."
          }
        }
      }
    },
    "LockPlus's network extension is turned off in System Settings." : {
      "comment" : "Banner (§6.15)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkerweiterung von LockPlus ist in den Systemeinstellungen deaktiviert."
          }
        }
      }
    },
