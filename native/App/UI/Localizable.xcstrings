    "LockPlus" : {
      "shouldTranslate" : false
    },
    "LockPlus can't import this profile as it is. Remove or replace these lines in the profile file, then import it again." : {
      "comment" : "Import sheet: what to do about unsupported directives",
      "localizations" : {
        "de" : {
