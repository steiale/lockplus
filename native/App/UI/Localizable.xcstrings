    "LockPlus adds the VPN configuration for %@ when %@ disconnects." : {
      "comment" : "Onboarding step 3: the first save waits for the running VPN (review 5); the second argument is a profile name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
