{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ / %@ this session" : {
      "comment" : "Detail, session transfer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@ in dieser Sitzung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@ this session"
          }
        }
      }
    },
    "%@ can't be read." : {
      "comment" : "Import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht gelesen werden."
          }
        }
      }
    },
    "%@ contains no .ovpn or .conf files." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält keine .ovpn- oder .conf-Dateien."
          }
        }
      }
    },
    "%@ contains “%@” twice and can't be imported." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ enthält „%2$@“ doppelt und kann nicht importiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ contains “%2$@” twice and can't be imported."
          }
        }
      }
    },
    "%@ couldn't connect: %@. No traffic leaves this Mac." : {
      "comment" : "Row 3a",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ konnte keine Verbindung herstellen: %2$@. Es verlässt kein Datenverkehr diesen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ couldn't connect: %2$@. No traffic leaves this Mac."
          }
        }
      }
    },
    "%@ disconnected unexpectedly." : {
      "comment" : "Notification body; profile name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde unerwartet getrennt."
          }
        }
      }
    },
    "%@ has more than 500 profiles. Split it into smaller archives." : {
      "comment" : "Zip import error (cap)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ enthält mehr als 500 Profile. Teile es in kleinere Archive auf."
          }
        }
      }
    },
    "%@ has no kill switch, so traffic outside the tunnel won't be blocked." : {
      "comment" : "Switch confirmation message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keinen Kill Switch, daher wird Datenverkehr außerhalb des Tunnels nicht blockiert."
          }
        }
      }
    },
    "%@ is a folder. Choose the profile files inside it." : {
      "comment" : "Import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein Ordner. Wähle die Profildateien darin aus."
          }
        }
      }
    },
    "%@ is connected. Save and reconnect?" : {
      "comment" : "Editor save confirmation (§6.9)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist verbunden. Sichern und erneut verbinden?"
          }
        }
      }
    },
    "%@ is encrypted. Unpack it and import the files." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist verschlüsselt. Entpacke es und importiere die Dateien."
          }
        }
      }
    },
    "%@ is larger than 100 MB and can't be imported." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist größer als 100 MB und kann nicht importiert werden."
          }
        }
      }
    },
    "%@ is waiting for you to sign in." : {
      "comment" : "Row 3",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wartet auf deine Anmeldung."
          }
        }
      }
    },
    "%@ isn't a valid zip archive or is damaged." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein gültiges Zip-Archiv oder ist beschädigt."
          }
        }
      }
    },
    "%@ lost its connection. No traffic leaves this Mac until LockPlus reconnects." : {
      "comment" : "Row 10",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat die Verbindung verloren. Es verlässt kein Datenverkehr diesen Mac, bis LockPlus die Verbindung wiederherstellt."
          }
        }
      }
    },
    "%@ needs a new one-time code" : {
      "comment" : "Notification title; profile name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ benötigt einen neuen Einmalcode"
          }
        }
      }
    },
    "%@ needs sign-in" : {
      "comment" : "Notification title; profile name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erfordert eine Anmeldung"
          }
        }
      }
    },
    "%@ per second" : {
      "comment" : "Spoken data rate, e.g. '1.2 megabytes per second'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Sekunde"
          }
        }
      }
    },
    "%@ stopped: %@. No traffic leaves this Mac." : {
      "comment" : "Row 7. No retry text.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde beendet: %2$@. Es verlässt kein Datenverkehr diesen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ stopped: %2$@. No traffic leaves this Mac."
          }
        }
      }
    },
    "%@ unpacks to more than 100 MB and can't be imported." : {
      "comment" : "Zip import error (cap)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist entpackt größer als 100 MB und kann nicht importiert werden."
          }
        }
      }
    },
    "%@ uses a compression method that isn't supported. Unpack it and import the files." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet eine nicht unterstützte Komprimierung. Entpacke es und importiere die Dateien."
          }
        }
      }
    },
    "%@ uses the ZIP64 format, which isn't supported. Unpack it and import the files." : {
      "comment" : "Zip import error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet das nicht unterstützte ZIP64-Format. Entpacke es und importiere die Dateien."
          }
        }
      }
    },
    "%@ wasn't reconnected: %@ was starting at the time. Connect %@ again if you need it." : {
      "comment" : "Problem: the end of a pause or an update couldn't reconnect a profile because another start was in flight (review 5)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde nicht wieder verbunden: %2$@ wurde gerade gestartet. Verbinde %3$@ erneut, wenn du es brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ wasn't reconnected: %2$@ was starting at the time. Connect %3$@ again if you need it."
          }
        }
      }
    },
    "%@ wasn't connected: macOS may restart %@. Connect %@ again if you need it." : {
      "comment" : "Problem: a Connect that waited for another profile's stop was dropped because macOS may restart that profile (review b47da1c L-2)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde nicht verbunden: macOS startet %2$@ eventuell neu. Verbinde %3$@ erneut, wenn du es brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ wasn't connected: macOS may restart %2$@. Connect %3$@ again if you need it."
          }
        }
      }
    },
    "%@ wasn't reconnected yet: macOS connects it when a network is available." : {
      "comment" : "Problem: the end of a pause or an update didn't reconnect a profile because macOS restarts it once a network returns (review b47da1c L-4)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde noch nicht wieder verbunden: macOS verbindet es, sobald ein Netzwerk verfügbar ist."
          }
        }
      }
    },
    "%@ · OTP" : {
