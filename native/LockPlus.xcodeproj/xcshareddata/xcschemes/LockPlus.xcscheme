         </TestPlanReference>
      </TestPlans>
      <EnvironmentVariables>
         <EnvironmentVariable
            key = "LIBDISPATCH_COOPERATIVE_POOL_STRICT"
            value = "1"
            isEnabled = "YES">
         </EnvironmentVariable>
      </EnvironmentVariables>
